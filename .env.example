# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Chave service_role: usada SOMENTE no servidor (rota de cobrança automática). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo para proteger a rota /api/cron/cobrancas
CRON_SECRET=troque-por-um-valor-aleatorio

# WhatsApp (opcional). Sem isso, o admin envia pelo link wa.me (abre o WhatsApp Web/app).
# Provedor compatível com Z-API. Deixe vazio para desativar o envio automático.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_CLIENT_TOKEN=

# Dias após o vencimento para começar a cobrar
NEXT_PUBLIC_DIAS_TOLERANCIA_COBRANCA=3
# A cobrança automática se repete a cada N dias enquanto estiver em aberto
INTERVALO_REPETICAO_COBRANCA=3
